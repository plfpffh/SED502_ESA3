# Vorlage für die lokale .env: kopieren mit  cp .env.example .env  und Werte eintragen.
# .env steht in .gitignore und wird nie committet. Auf Vercel als Umgebungsvariablen eintragen.

# Google Gemini API-Key aus https://aistudio.google.com/app/apikey (jede Person ihren eigenen, nicht weitergeben).
# Bewusst OHNE VITE_-Präfix: Er wird nur serverseitig in api/ki.ts gelesen und landet nie im Browser.
GEMINI_API_KEY=

# Optional: anderes Gemini-Modell, Standard siehe api/ki.ts
# GEMINI_MODEL=

# --- ESA 3: KI-Kontingent (api/_kontingent.ts) ---
# Lokal ohne Redis gibt es kein Limit. Auf Vercel ohne Redis ist die KI nur mit Zugangscode nutzbar.

# Freie KI-Anfragen pro Tag (Wiener Zeit) ohne Zugangscode, Standard 10
# KI_TAGESLIMIT=10

# SHA-512 des Zugangscodes als Hex (128 Zeichen). Der Code selbst steht nirgends im Repository oder in Vercel.
# Code und Hash zusammen erzeugen (der Code erscheint nur in dieser Ausgabe):
#   node -e "const c=require('crypto');const k=c.randomBytes(32).toString('base64url');console.log('Code: '+k);console.log('KI_ZUGANGSCODE_SHA512='+c.createHash('sha512').update(k).digest('hex'))"
KI_ZUGANGSCODE_SHA512=

# Upstash Redis (REST). Auf Vercel setzt die Upstash-Integration diese Variablen selbst, je nach Version mit
# KV_REST_API_* oder UPSTASH_REDIS_REST_* benannt. Beide Varianten werden gelesen. Lokal nur zum Testen nötig.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
